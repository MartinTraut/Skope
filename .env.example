# Versand der Formularanfragen (lib/notify.ts).
# Ohne diese Werte zeigt das Formular einen ehrlichen Hinweis mit Telefonnummer
# und E-Mail-Adresse — statt einer Erfolgsmeldung für eine Mail, die nie ankommt.
#
# Vor dem Livegang zwingend setzen, sonst gehen Anfragen verloren.

RESEND_API_KEY=
# Verifizierte Absenderadresse beim Mail-Provider, z. B. noreply@skopegebrauchtwarenhandel.de
INQUIRY_FROM=
# Optional — ohne Angabe geht die Anfrage an site.email aus lib/site.ts
INQUIRY_TO=

# Google-Bewertung (lib/google-rating.ts).
# Ohne diese Werte zeigt die Seite den letzten von Hand abgeglichenen Stand aus
# `googleRatingFallback` in lib/site.ts – sie bleibt also funktionsfähig, aber
# die Zahl friert wieder ein.
#
# GOOGLE_PLACE_ID: die Ortskennung des Unternehmensprofils, Form „ChIJ…".
#   Zu finden über den Place-ID-Finder von Google oder einen Textsuche-Aufruf
#   der Places API mit Name und Adresse.
# GOOGLE_PLACES_API_KEY: Schlüssel eines Google-Cloud-Projekts mit aktivierter
#   „Places API (New)" und aktiver Abrechnung. Der Schlüssel wird nur auf dem
#   Server gelesen und gehört deshalb ausdrücklich *nicht* hinter NEXT_PUBLIC_.
#   Im Cloud-Projekt auf die Places API einschränken.

GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# Verkaufsweg (lib/commerce.ts).
# catalog      – Auslage mit Anfrage. Kein Warenkorb, keine Reservierung,
#                keine Zahlung. Das ist der heutige Betrieb und die
#                Voreinstellung; ohne diese Variable passiert nichts anderes.
# reservation  – setzt einen Speicher voraus, der Reservierungen hält. Den
#                gibt es nicht; der Wert fällt deshalb auf catalog zurück.
# checkout     – echter Kauf über Shopify. Verlangt die beiden Werte darunter;
#                fehlen sie, fällt der Modus auf catalog zurück und schreibt
#                eine Zeile ins Serverprotokoll. Ein Kaufknopf ohne Kaufweg
#                wäre eine Zusage, die der Betrieb nicht halten kann.
COMMERCE_MODE=

# Shopify-Storefront (lib/commerce-shopify.ts) — noch nicht angebunden.
# Der alte Shop läuft unter qcdf0s-b5.myshopify.com; Zugangsdaten liegen hier
# nicht vor und werden nicht erraten. Beide Werte werden ausschließlich auf
# dem Server gelesen und gehören deshalb NICHT hinter NEXT_PUBLIC_.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Optional, Vorgabe 2025-01
SHOPIFY_API_VERSION=

# Kennzahlen der Website (lib/metrics.ts, /kennzahlen).
#
# METRICS_PASSWORD: Zugang zur Auswertung, mindestens 8 Zeichen. Ohne diese
#   Variable gibt es die Route gar nicht — sie antwortet mit 404 statt mit
#   einer Passwortmaske, denn eine Maske verrät, dass dort etwas liegt.
#   Frei wählbar, gehört nicht ins Repository.
METRICS_PASSWORD=

# UPSTASH_*: der Zählspeicher (Redis über REST). Ohne die beiden Werte wird
#   nichts gezählt und die Seite zeigt ausgewiesene Beispielzahlen. Auf Vercel
#   über Storage → Upstash Redis anlegen; die Variablen setzt die Integration
#   selbst. Gespeichert werden ausschließlich Tagessummen — keine IP, keine
#   Kennung, kein Cookie. Wer das ändert, holt ein Einwilligungsbanner ins Haus.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LIMIT_SALT: Streusalz für die Drosselung (lib/rate-limit.ts). Der Schlüssel
#   im Speicher ist ein gekürzter Streuwert der IP; mit einem eigenen Salz
#   lässt sich aus dem Eintrag auch dann keine IP zurückrechnen, wenn jemand
#   den Speicher liest. Ohne Angabe gilt ein fester Vorgabewert — es
#   funktioniert also, ist nur schwächer. Beliebige lange Zeichenkette.
LIMIT_SALT=
