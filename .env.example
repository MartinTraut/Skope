# Versand der Formularanfragen (lib/notify.ts).
# Ohne diese Werte zeigt das Formular einen ehrlichen Hinweis mit Telefonnummer
# und E-Mail-Adresse — statt einer Erfolgsmeldung für eine Mail, die nie ankommt.
#
# Vor dem Livegang zwingend setzen, sonst gehen Anfragen verloren.

RESEND_API_KEY=
# Verifizierte Absenderadresse beim Mail-Provider, z. B. noreply@skopegebrauchtwarenhandel.de
INQUIRY_FROM=
# Optional — ohne Angabe geht die Anfrage an site.email aus lib/site.ts
INQUIRY_TO=

# Google-Bewertung (lib/google-rating.ts).
# Ohne diese Werte zeigt die Seite den letzten von Hand abgeglichenen Stand aus
# `googleRatingFallback` in lib/site.ts – sie bleibt also funktionsfähig, aber
# die Zahl friert wieder ein.
#
# GOOGLE_PLACE_ID: die Ortskennung des Unternehmensprofils, Form „ChIJ…".
#   Zu finden über den Place-ID-Finder von Google oder einen Textsuche-Aufruf
#   der Places API mit Name und Adresse.
# GOOGLE_PLACES_API_KEY: Schlüssel eines Google-Cloud-Projekts mit aktivierter
#   „Places API (New)" und aktiver Abrechnung. Der Schlüssel wird nur auf dem
#   Server gelesen und gehört deshalb ausdrücklich *nicht* hinter NEXT_PUBLIC_.
#   Im Cloud-Projekt auf die Places API einschränken.

GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
