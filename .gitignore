# Abhängigkeiten
/node_modules
/.pnp
.pnp.*

# Build-Artefakte
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Umgebungsvariablen — enthalten Zugangsdaten (RESEND_API_KEY o. Ä.)
.env
.env*.local

# Deployment
.vercel

# Betriebssystem und Editor
.DS_Store
*.pem
.idea/
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Angebot und Kalkulation bleiben lokal – das Repository ist öffentlich.
angebot-skope-website.md
kalkulation-skope-gesamtpaket.md

# Streuschüsse aus Screenshot-Werkzeugen
/[0-9a-f][0-9a-f]*-*-*-*-*.png

# Rohmaterial im Projektstamm (Videoschnitt, Screenshots aus der Abstimmung).
# Ausgeliefert wird nur, was optimiert unter public/ liegt.
/*.mp4

# Sicherungskopien und Rohmaterial aus der Abstimmung bleiben lokal.
/.backup/
/*.html

# Telefonaufnahmen aus dem Betrieb, unbearbeitet und je 3–10 MB.
# Sie tragen EXIF mit Aufnahmeort auf ein paar Meter genau, Gerät und
# Zeitstempel – das Repository ist öffentlich. Ausgeliefert wird nur die
# verkleinerte Fassung unter public/img/werkstatt/, und `sharp` schreibt
# ohne `withMetadata()` keine EXIF-Daten in die Ausgabe.
/PXL_*.jpg
